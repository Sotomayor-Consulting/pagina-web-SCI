    title=`360° Solutions for LLCs, Taxation, and Global Technology`
    subTitle="Sotomayor Consulting International is a boutique legal, tax, and technology consulting firm that helps clients (especially international ones) set up companies in the U.S. and other jurisdictions, connect them to the financial system (banks/fintech), comply with taxes and accounting, and build the digital infrastructure (AI, web, Stripe, telephony) needed to operate globally."
    primaryBtn="Start Your LLC"
    primaryBtnURL="/en/#precios"
    secondaryBtn="Our Services"
    secondaryBtnURL="/en/#cartas-servicios"
    rating=`<span class="font-bold">4.8</span> / 5`
    starCount={4}
    reviews=`From Over <span class="font-bold">12.8k</span> Reviews`
    alt="Video of businesses, people, and development"
    titleslide2="Your global expansion deserves a structure, not just a procedure."
    descriptionslide2="We are the strategic ally that cares for your assets with rigor and expert support, ensuring that your entry into the world is solid, correct, and, above all, definitive."
    dabgeslide3="We provide clarity and security"
    tituloslide3="Your vision in a solid and strategic legal architecture."
    descriptionslide3="At Sotomayor Consulting International, we design the exact structure your assets need to expand successfully. We are architects of your legal and tax security in the United States and the world."
    button1slide3="Free Consultation"
    button2slide3="Schedule a meeting"
  /> -->
  
  <RelayPartnerSection />

  <CartasDeServiciosV2
    title="Everything for Your Business"
    subTitle="We offer personalized service solutions for professionals, individuals, families, and businesses, addressing their specific needs."
  />

  <FeaturesGeneral
    title="What Sets Us Apart"
    subTitle="Our priority is client trust. With a comprehensive approach, we design excellent solutions that build lasting relationships."
    src={featureImage}
    alt="ScrewFast products in floating boxes"
    features={features}
  />

  <GridServicios
    title="Star Product"
    description="We accompany global entrepreneurs in forming their company in the U.S., tax design, documentary assistance for third-party banking onboarding, and legal compliance advisory from anywhere in the world."
    link="#precios"
    grid2="Countries"
    grid3="Explore our services"
    grid3link="/en/services"
    grid4="Contact us"
    grid4link="/en/contact"
  />

  <TestimonialsSection
    title="Boost Your Projects"
    subTitle="At Sotomayor Consulting International, we guarantee an agile start with ongoing support. Experience the redefinition of consulting."
    ;
    testimonials={[
      {
        content:
          "Sotomayor Consulting International gave me a clear solution for my LLC. The process was straightforward, and the support helped me set up and enable payments with third-party payment processors (e.g., Stripe/PayPal). I recommend the service.",
        author: "Diego Morales",
        role: "E-commerce Entrepreneur",
        avatarSrc:
          "https://images.unsplash.com/photo-1624561172888-ac93c696e10c?q=80&w=389&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
      },
    ]}
    statistics={[
      {
        count: "5,000",
        description: "Companies Incorporated",
      },
      {
        count: "1,354",
        description: "Projects Completed",
      },
      {
        count: "97%",
        description: "Satisfaction",
      },
      {
        count: "10",
        description: "Years of Experience",
      },
    ]}
  />

  <Evaluacion
    title="Find out if an LLC is really the best structure for you."
    button="Take the free consultation"
  >
    Avoid legal and tax mistakes that can cost you thousands of dollars.
    <b>In just 2 minutes, our free consultation</b> analyzes your specific situation
    and clearly indicates whether a U.S. LLC is the right option for
    your case or if there is a better alternative.
  </Evaluacion>

  <PricingSection pricing={pricing} />

  <FAQ title="Frequently Asked<br />Questions" faqs={faqs} />

  <HeroSectionAlt
    title="Let's Work Together"
    subTitle="SCI is a comprehensive specialized service, meticulously designed with global solutions in company incorporation, tax planning, migration services, and international real estate."
    url="/en/contact"
    btnTitle="Contact us"
  />
</MainLayout>
