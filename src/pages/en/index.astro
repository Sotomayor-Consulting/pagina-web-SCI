---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import HeroSectionVideos from "@components/sections/landing/HeroSectionVideos.astro";
import HeroSectionAlt from "@components/sections/landing/HeroSectionAlt.astro";
import FeaturesGeneral from "@components/sections/features/FeaturesGeneral.astro";
import TestimonialsSection from "@components/sections/testimonials/TestimonialsSection.astro";
import PricingSection from "@components/sections/pricing/PricingSection.astro";
import FAQ from "@components/sections/misc/FAQ.astro";
import faqs from "@data/en/faqs.json";
import features from "@data/en/features.json";
import pricing from "@data/en/pricing.json";
import featureImage from "@images/home-image.jpg";
import CartasDeServiciosV2 from "@components/sections/landing/CartasDeServiciosV2.astro";
import GridServicios from "@/components/sections/features/GridServicios.astro";
import Banner from "@components/ui/banners/AnnouncementBanner.astro";
import RelayPartnerSection from "@components/sections/landing/RelayPartnerSection.astro";
import Evaluacion from "@components/sections/evaluacion/CallToActionEvaluacion.astro";
import Heroanimatev2 from "@components/sections/landing/Hero_animation_v2.astro";
---

<MainLayout>
  <Banner
    title="Sotomayor Consulting International is a consulting firm, not a bank. We do not grant loans, but we provide all our support in setting up your company, paperwork, account opening, and technological solutions. We are here to advise you!"
    url="/"
    btnTitle="Learn more"
    btnId="xd"
  />

  <Heroanimatev2
    title="We structure your global expansion with legal, tax, and technological precision."
    spam="Expand your business to the U.S."
    description="Sotomayor Consulting International is a boutique consulting firm specializing in legal, tax, and technological advisory that helps clients (mainly international) to set up companies in the U.S. and other jurisdictions, connect them to the financial system (banks/fintechs), comply with tax and accounting obligations, and build the digital infrastructure (AI, web, Stripe, telephony) needed to operate globally."
    Btnlabel="Start your LLC"
    slot="hero"
/>

